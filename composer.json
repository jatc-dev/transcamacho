{
  "name": "transcamacho/fuec",
  "description": "Sistema de gestión de extractos de contrato FUEC - Transcamacho S.A.S. (Modernizado)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.1"
  },
  "require-dev": {},
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Config\\": "config/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  }
}
